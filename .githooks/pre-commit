#!/usr/bin/env bash
# pre-commit hook — fast checks on the files STAGED for this commit only.
#
#   * staged *.sh   -> ShellCheck (same options as `make lint`: -x, -s bash,
#                      -s sh for POSIX-sh scripts); locales/*.sh -> bash -n,
#                      as in `make lint`.
#   * staged *.conf -> scripts/check-conf.sh (config syntax).
#   * staged locales/*.sh without the sibling locale -> non-blocking reminder
#                      pointing at `make check-i18n`.
#
# Exit status: 1 when ShellCheck / bash -n / check-conf reports a problem
# (the commit is blocked), 0 otherwise. A missing `shellcheck` only warns.
# Bypass once with `git commit --no-verify`; disable for good with
# `git config --unset core.hooksPath`.
#
# Bash 3.2+ compatible (macOS stock bash); no GNU/BSD-only tool options.

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || {
  printf 'pre-commit: not inside a git work tree, skipping.\n' >&2
  exit 0
}
cd "$REPO" || exit 0

TMP=$(mktemp -d "${TMPDIR:-/tmp}/tm-pre-commit.XXXXXX") || exit 0
trap 'rm -rf "$TMP"' EXIT

# Added/Copied/Modified/Renamed files, NUL-separated (safe for any file name).
if ! git diff --cached --name-only --diff-filter=ACMR -z > "$TMP/staged"; then
  printf 'pre-commit: could not list staged files.\n' >&2
  exit 1
fi

SH_FILES=()
LOCALE_FILES=()
CONF_FILES=()
HAS_LOCALE_STAGED=0
while IFS= read -r -d '' f; do
  [ -f "$f" ] || continue
  case "$f" in
    locales/*.sh)
      LOCALE_FILES+=("$f")
      HAS_LOCALE_STAGED=1
      ;;
    *.sh) SH_FILES+=("$f") ;;
    *.conf) CONF_FILES+=("$f") ;;
  esac
done < "$TMP/staged"

STATUS=0

# --- ShellCheck / bash -n ----------------------------------------------------
if [ "${#SH_FILES[@]}" -gt 0 ]; then
  if command -v shellcheck >/dev/null 2>&1; then
    for f in "${SH_FILES[@]}"; do
      # Mirror `make lint`: POSIX-sh shebang -> -s sh, everything else -s bash.
      first=$(head -n 1 < "$f" 2>/dev/null | tr -d '\r')
      case "$first" in
        '#!/bin/sh'*|'#!/usr/bin/env sh'*|'#! /bin/sh'*) dialect="sh" ;;
        *) dialect="bash" ;;
      esac
      if ! shellcheck -x -s "$dialect" -- "$f"; then
        printf 'pre-commit: ShellCheck failed for %s\n' "$f" >&2
        STATUS=1
      fi
    done
  else
    printf 'pre-commit: warning: shellcheck not installed — skipping ShellCheck on %d staged shell file(s).\n' "${#SH_FILES[@]}" >&2
    printf '            Install it (brew install shellcheck) to lint before committing; CI still runs it.\n' >&2
  fi
fi

for f in ${LOCALE_FILES[@]+"${LOCALE_FILES[@]}"}; do
  if ! bash -n "$f"; then
    printf 'pre-commit: syntax error in %s\n' "$f" >&2
    STATUS=1
  fi
done

# --- Config syntax -----------------------------------------------------------
if [ "${#CONF_FILES[@]}" -gt 0 ]; then
  if [ -f scripts/check-conf.sh ]; then
    if ! bash scripts/check-conf.sh "${CONF_FILES[@]}"; then
      printf 'pre-commit: config validation failed (see errors above).\n' >&2
      STATUS=1
    fi
  else
    printf 'pre-commit: warning: scripts/check-conf.sh not found — skipping config validation.\n' >&2
  fi
fi

# --- Locale sync reminder (never blocks) ------------------------------------
if [ "$HAS_LOCALE_STAGED" -eq 1 ]; then
  MISSING=""
  while IFS= read -r tracked; do
    case "$tracked" in
      locales/*.sh) ;;
      *) continue ;;
    esac
    found=0
    for f in "${LOCALE_FILES[@]}"; do
      [ "$f" = "$tracked" ] && found=1
    done
    [ "$found" -eq 0 ] && MISSING="${MISSING:+$MISSING, }$tracked"
  done < <(git ls-files -- 'locales/*.sh')
  if [ -n "$MISSING" ]; then
    printf 'pre-commit: reminder: locale file(s) staged without %s — keep translations in sync (run: %s).\n' "$MISSING" "make check-i18n" >&2
  fi
fi

exit "$STATUS"
